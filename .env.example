META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
PORT=3000
GRAPH_API_VERSION=v21.0

# AI providers. AI_PROVIDER is the primary (openai or gemini); the other is used
# as automatic failover if the primary errors. Set the keys for whichever you use.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
BUSINESS_NAME=
BUSINESS_ABOUT=
BUSINESS_TONE=friendly and professional

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Minutes a human can sit on a chat before the bot resumes. 0 disables it.
HANDOFF_RESUME_MINUTES=0

# Production only (docker compose). In prod DATABASE_URL is built from these, so
# the value above is ignored there.
DOMAIN=
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp
POSTGRES_DB=whatsapp
