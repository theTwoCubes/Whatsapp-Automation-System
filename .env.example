# Copy this file to .env and fill in the values.
# Never commit .env. Only this example, with empty values, is version controlled.

# ---- Domains (point both A records at this server before starting Caddy) ----
DOMAIN=example.com
CHATWOOT_HOST=chat.example.com
N8N_HOST=flow.example.com
LETSENCRYPT_EMAIL=

# ---- Postgres (shared instance) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# databases created on first boot: chatwoot, n8n, app
POSTGRES_APP_DB=app
POSTGRES_CHATWOOT_DB=chatwoot
POSTGRES_N8N_DB=n8n

# ---- Redis ----
REDIS_PASSWORD=

# ---- Chatwoot ----
# Generate with: openssl rand -hex 64
CHATWOOT_SECRET_KEY_BASE=
# Set to your Chatwoot URL once decided
FRONTEND_URL=https://chat.example.com
# SMTP is optional. Leave blank to disable outbound email from Chatwoot.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAILER_SENDER_EMAIL=

# ---- n8n ----
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
WEBHOOK_URL=https://flow.example.com/
GENERIC_TIMEZONE=Asia/Kolkata

# ---- WhatsApp Cloud API (from Meta app + System User) ----
# Permanent System User token with whatsapp_business_messaging and
# whatsapp_business_management. Not a personal token. See scripts/register_number.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# You choose this string, then set the same value in the Meta app webhook config
WHATSAPP_VERIFY_TOKEN=
GRAPH_API_VERSION=v21.0

# ---- Chatwoot API (created inside Chatwoot after first login) ----
CHATWOOT_BASE_URL=https://chat.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
# Profile > Access Token in Chatwoot
CHATWOOT_API_TOKEN=

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Knowledge base (Google Sheet published as CSV, or a sheet API key) ----
# Simplest path: File > Share > Publish to web > CSV, paste that URL here.
KNOWLEDGE_BASE_CSV_URL=

# ---- Media source ----
# local  -> read files from ./media
# drive  -> read from a Google Drive folder via a service account
MEDIA_SOURCE=local
MEDIA_DIR=./media
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- App database URL used by scripts/ ----
APP_DATABASE_URL=postgresql://postgres:@postgres:5432/app
