META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
PORT=3000
GRAPH_API_VERSION=v21.0

# Optional error tracking. Leave blank and nothing changes - the app runs
# exactly as it does today. Set a free Sentry project's DSN
# (https://sentry.io) to have unhandled errors, route 500s, and webhook
# processing failures reported there instead of only living in the logs.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# AI providers. AI_PROVIDER is the primary (openai or gemini); the other is used
# as automatic failover if the primary errors. Set the keys for whichever you use.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY is also what powers reading an inbound photo/PDF (see
# MEDIA_ANALYSIS_MAX_PER_HOUR below) - set it even if OpenAI is the primary
# chat provider, or attachments are stored with no description at all.
BUSINESS_NAME=
# The AI's display name in its own replies, e.g. "Hi, I'm Adi from ...".
BOT_NAME=Adi
# A few sentences the AI leans on for grounding: what the business does, where
# it is based, how long it has been running, and what it is genuinely good at.
# The more specific and factual this is, the less the AI has to guess.
BUSINESS_ABOUT=
BUSINESS_TONE=friendly and professional
# Optional contact facts the AI can share with a lead when asked. Leave blank
# to have it just not mention what is not set.
WEBSITE_URL=
CONTACT_PHONE=
INSTAGRAM_URL=

# How much room the approved answers get in a prompt. Whole packs are handed
# to the model rather than search results, so this is a ceiling: if a pack
# does not fit, the least important entries are dropped rather than ranked
# (entries marked !pinned are never dropped). Budget for every pack a single
# conversation can accumulate, not one: packs are sticky, so a lead who
# mentions two services carries both for the rest of the chat. At 6000 a
# lead on two of three services was already silently losing answers.
FAQ_BUDGET_TOKENS=12000

# How often the weekly pass scans recent chats for answers the team gave that
# are not written down yet. Nothing it finds goes live without approval.
LEARNING_INTERVAL_DAYS=7

# Canned replies. All can also be edited live from the console Settings tab.
FALLBACK_MESSAGE=
HANDOFF_MESSAGE=
OPT_OUT_MESSAGE=

# Web push. Generate once with `node scripts/generate-vapid.js`, then paste
# both values here. Without them push notifications silently no-op.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Firebase Cloud Messaging (for the Android APK push notification path). The
# project id is read from the service account json itself, so this is the only
# value needed. Base64 encode the key:
#   Firebase console, Project settings, Service accounts, Generate new private key
#   base64 -w 0 your-service-account.json
FCM_SERVICE_ACCOUNT_JSON=

# Message batching: rapid fire messages from the same lead are coalesced into
# one ai call instead of a reply per message. The debounce is how long to wait
# for them to stop typing - raise it if leads still get a reply per message,
# lower it if a single message feels slow to answer. Messages arriving while a
# reply is already being written always join the next batch regardless of
# this, since that window is however long the model takes.
MESSAGE_BATCH_DEBOUNCE_MS=4000
MESSAGE_BATCH_MAX_WAIT_MS=12000

# Media library: how long the bot avoids sending the same file to the same
# conversation again after sending it once, so a lead is not spammed by a
# repeat send on the next reply that references the same FAQ answer.
MEDIA_RESEND_COOLDOWN_MINUTES=180

# How many images/documents from the same lead get looked at with Gemini
# vision per rolling hour, before the rest are just stored without analysis.
# Guards the vision API bill against someone spamming files.
MEDIA_ANALYSIS_MAX_PER_HOUR=6

# Drip follow ups. Leave empty until you have templates approved in WhatsApp
# Manager - configure the general sequence and per-service overrides from the
# Follow-ups page in the console once they're synced.
DRIP_STEPS=
DRIP_TEMPLATE_LANG=en

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Minutes a stalled human or pending handoff waits before the bot resumes.
# 0 disables it.
HANDOFF_RESUME_MINUTES=0

# White label branding for the console. Also editable in the console.
BRAND_NAME=theTwoCubes
BRAND_WATERMARK=Made by theTwoCubes
SUPPORT_EMAIL=build@thetwocubes.com
ACCENT_COLOR=#00a884

# Production only (docker compose). In prod DATABASE_URL is built from these, so
# the value above is ignored there.
DOMAIN=
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp
POSTGRES_DB=whatsapp
