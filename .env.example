META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
DATABASE_URL=postgres://whatsapp:whatsapp@localhost:5432/whatsapp
PORT=3000
GRAPH_API_VERSION=v21.0

# AI providers. AI_PROVIDER is the primary (openai or gemini); the other is used
# as automatic failover if the primary errors. Set the keys for whichever you use.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
BUSINESS_NAME=
# A few sentences the AI leans on for grounding: what the business does, where
# it is based, how long it has been running, and what it is genuinely good at.
# The more specific and factual this is, the less the AI has to guess.
BUSINESS_ABOUT=
BUSINESS_TONE=friendly and professional

# Embeddings are provider fixed (OpenAI text-embedding-3-small), used for
# knowledge retrieval, media matching, and dedup. Requires OPENAI_API_KEY even
# if AI_PROVIDER is gemini.
EMBEDDING_MODEL=text-embedding-3-small
RETRIEVAL_TOP_K=12
RETRIEVAL_TOKEN_BUDGET=1200
RETRIEVAL_SIMILARITY_FLOOR=0.5
DEDUP_SIMILARITY_THRESHOLD=0.93
# How often the weekly learning pass scans recent chats for new facts to
# queue for review.
LEARNING_INTERVAL_DAYS=7

# Canned replies. All can also be edited live from the console Settings tab.
FALLBACK_MESSAGE=
HANDOFF_MESSAGE=
ATTACHMENT_MESSAGE=

# Message batching: rapid fire messages from the same lead are coalesced into
# one ai call instead of a reply per message.
MESSAGE_BATCH_DEBOUNCE_MS=2500
MESSAGE_BATCH_MAX_WAIT_MS=8000

# Media library: how long the bot avoids resending the same file in a
# conversation, and how close a match has to be to send it at all.
MEDIA_RESEND_COOLDOWN_MINUTES=180
MEDIA_SIMILARITY_FLOOR=0.72

# Drip follow ups. Each entry is templateName:days, the templates must be
# approved in WhatsApp Manager first.
DRIP_STEPS=drip_day3:3,drip_day5:5,drip_day8:8
DRIP_TEMPLATE_LANG=en

JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Minutes a stalled human or pending handoff waits before the bot resumes.
# 0 disables it.
HANDOFF_RESUME_MINUTES=0

# White label branding for the console. Also editable in the console.
BRAND_NAME=theTwoCubes
BRAND_WATERMARK=Made by theTwoCubes
SUPPORT_EMAIL=build@thetwocubes.com
ACCENT_COLOR=#00a884

# Production only (docker compose). In prod DATABASE_URL is built from these, so
# the value above is ignored there.
DOMAIN=
POSTGRES_USER=whatsapp
POSTGRES_PASSWORD=whatsapp
POSTGRES_DB=whatsapp
