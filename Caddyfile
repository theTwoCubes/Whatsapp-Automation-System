# Caddy reverse proxy with automatic HTTPS via Let's Encrypt.
# Both hostnames must resolve to this server's public IP before first start,
# otherwise the certificate challenge fails.

{
	email {$LETSENCRYPT_EMAIL}
}

{$CHATWOOT_HOST} {
	reverse_proxy chatwoot:3000
}

{$N8N_HOST} {
	reverse_proxy n8n:5678
}
