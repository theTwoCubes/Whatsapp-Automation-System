    "openai": "^4.56.0",
    "pg": "^8.12.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/assets": "^3.0.5",
