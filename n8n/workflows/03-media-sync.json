{
  "name": "03 - Media Sync",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true
  },
  "meta": {
    "description": "Optional. Runs scripts/upload_media.py on a schedule so new artwork gets a Meta media ID in media_assets. Only works if the n8n container has python3. The reliable path is the uploader service: docker compose run --rm uploader, scheduled from host cron. See README."
  },
  "pinData": {},
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] }
      },
      "id": "node-schedule",
      "name": "Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, 300]
    },
    {
      "parameters": {
        "command": "python3 /scripts/upload_media.py"
      },
      "id": "node-exec",
      "name": "Run Uploader",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-360, 300]
    }
  ],
  "connections": {
    "Every 6 Hours": { "main": [[{ "node": "Run Uploader", "type": "main", "index": 0 }]] }
  }
}
